// Keep blank and duplicate ASCII slots in order.
TILESET sci_font "font.png" NONE NONE ROW
IMAGE title_image "title.png" NONE
IMAGE stars_image "stars.png" NONE
SPRITE twin_image "twins.png" 2 2 NONE 0 NONE NONE
SPRITE guard_image "guard.png" 3 3 NONE 0 NONE NONE
SPRITE utility_image "utility.png" 4 4 NONE 0
SPRITE ship_image "ship.png" 2 2 NONE 0
SPRITE enemy_image "enemies.png" 2 2 NONE 0
// Keep the sparse dissolve frames in one 32x32 hardware piece.
SPRITE boss_image "boss.png" 4 4 NONE 0 NONE NONE
SPRITE reaver_image "reaver.png" 4 4 NONE 0 NONE NONE
SPRITE bullet_image "bullets.png" 1 1 NONE 0
SPRITE pickup_image "pickups.png" 2 2 NONE 0
SPRITE effect_image "effects.png" 2 2 NONE 0
XGM2 reaver_music "boss2.vgm"
XGM2 credits_music "credits.vgm"
XGM2 stage2_music "stage2.vgm"
XGM2 over_music "game_over.vgm"
XGM2 title_music "title.vgm"
XGM2 stage_music "course.vgm"
XGM2 boss_music "boss.vgm"
XGM2 clear_music "victory.vgm"
WAV fire_sound "fire.wav" XGM2
WAV pickup_sound "coin.wav" XGM2
WAV bomb_sound "bomb.wav" XGM2
WAV warning_sound "warning.wav" XGM2
WAV hit_sound "hit.wav" XGM2
WAV kill_sound "kill.wav" XGM2
WAV voice_bomb "voice_bomb.wav" XGM2
WAV voice_power "voice_power.wav" XGM2
WAV voice_over "voice_over.wav" XGM2
WAV voice_shield "voice_shield.wav" XGM2
WAV voice_boss "voice_boss.wav" XGM2
WAV empty_sound "empty.wav" XGM2
WAV voice_spread "voice_spread.wav" XGM2
WAV voice_twin "voice_twin.wav" XGM2
